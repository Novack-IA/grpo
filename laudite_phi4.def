Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.01-py3

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y git libsndfile1

    # Atualiza pip e instala dependências base do seu projeto
    pip install --upgrade pip
    pip install transformers accelerate peft trl datasets \
                sentence-transformers google-generativeai \
                wandb python-dotenv pandas tqdm

    # Instalação crítica para H100: FlashAttention 2 ou 3
    # A H100 exige FlashAttention para não estourar VRAM com o Phi-4
    pip install flash-attn --no-build-isolation

%environment
    export LC_ALL=C
    export PYTHONIOENCODING=utf-8